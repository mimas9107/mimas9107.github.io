# 根據 npm 文件，忽略 node_modules 目錄
# https://docs.npmjs.com/misc/removing-files-from-git
/node_modules

# 忽略 .env 環境變數檔案
# https://github.com/motdotla/dotenv
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 忽略建置輸出的目錄
# 這些檔案通常由建置工具 (如 Webpack, Vite) 生成，不應納入版本控制
/dist
/build
/out

# 記錄檔
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS 系統檔案
.DS_Store

# Windows 系統檔案
Thumbs.db

# IDE/編輯器設定檔案
.vscode/
.idea/

# 測試覆蓋率報告
coverage/

# 暫存檔或快取
.cache
